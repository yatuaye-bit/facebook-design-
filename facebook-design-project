        align-items: center;
        color: white;
        font-size: 13px;
        font-weight: bold;
        margin-left: 15px;
    }
    .nav-input{
        width: 300px;
        display: flex;
        align-items: center;
        margin-right: 15px;
        margin-left: 15px;
    }
    .nav-search-box{
        display: flex;
        flex: 1;
        border-radius: 15px;
        border: none;
        padding-left: 10px;
        padding-top: 7px;
        padding-bottom: 7px;
    }
    .nav-down{
